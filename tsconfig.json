{
  "compilerOptions": {
    // Output Settings
    "target": "ES2022",                    // JavaScript version to compile to
    "module": "ESNext",                    // Use modern ES modules
    "outDir": "./dist",                    // Where compiled files go
    "rootDir": "./",                       // Source files location

    // Module Resolution
    "moduleResolution": "node",            // How to resolve imports
    "esModuleInterop": true,               // Better compatibility with CommonJS
    "allowSyntheticDefaultImports": true,  // Allow default imports from modules

    // Type Checking
    "strict": true,                        // Enable all strict type checks
    "noImplicitAny": true,                 // Error on implied 'any' type
    "strictNullChecks": true,              // Strict null checking
    "strictFunctionTypes": true,           // Strict function type checking

    // Code Quality
    "noUnusedLocals": true,                // Error on unused variables
    "noUnusedParameters": true,            // Error on unused parameters
    "noImplicitReturns": true,             // Error if not all paths return

    // Other Options
    "skipLibCheck": true,                  // Skip type checking of declaration files
    "forceConsistentCasingInFileNames": true, // Enforce consistent file naming
    "resolveJsonModule": true              // Allow importing JSON files
  },
  "include": [
    "**/*.ts"                              // Include all TypeScript files
  ],
  "exclude": [
    "node_modules",                        // Don't compile node_modules
    "dist"                                 // Don't compile output directory
  ]
}
